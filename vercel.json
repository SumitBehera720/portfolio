{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sumitbehera-brown.vercel.app"
        }
      ],
      "destination": "https://sumitbehera.vercel.app/:path*",
      "permanent": true
    }
  ]
}
